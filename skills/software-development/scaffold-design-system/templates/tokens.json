{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "$description": "Color palette. Customize for your brand.",
    "primary": { "$value": "#2563eb", "$type": "color" },
    "primary-foreground": { "$value": "#ffffff", "$type": "color" },
    "secondary": { "$value": "#475569", "$type": "color" },
    "secondary-foreground": { "$value": "#ffffff", "$type": "color" },
    "destructive": { "$value": "#dc2626", "$type": "color" },
    "destructive-foreground": { "$value": "#ffffff", "$type": "color" },
    "background": {
      "default": { "$value": "#ffffff", "$type": "color" },
      "muted": { "$value": "#f1f5f9", "$type": "color" },
      "subtle": { "$value": "#f8fafc", "$type": "color" }
    },
    "text": {
      "$description": "Text colors. primary and secondary meet WCAG AA (4.5:1) on every background token. muted is below AA for body copy by design: use it for large text and non-essential labels only.",
      "primary": { "$value": "#0f172a", "$type": "color" },
      "secondary": { "$value": "#475569", "$type": "color" },
      "muted": { "$value": "#64748b", "$type": "color" }
    },
    "border": {
      "default": { "$value": "#e2e8f0", "$type": "color" },
      "strong": { "$value": "#cbd5e1", "$type": "color" }
    },
    "accent": { "$value": "#2563eb", "$type": "color" },
    "accent-foreground": { "$value": "#ffffff", "$type": "color" }
  },
  "spacing": {
    "$description": "Spacing scale. Base unit 4px.",
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "12px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "xl": { "$value": "24px", "$type": "dimension" },
    "2xl": { "$value": "32px", "$type": "dimension" },
    "3xl": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "$description": "Border radius scale.",
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "6px", "$type": "dimension" },
    "lg": { "$value": "8px", "$type": "dimension" },
    "xl": { "$value": "12px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "typography": {
    "$description": "Type scale. Uses system font stack by default.",
    "heading": {
      "xl": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "fontSize": "30px",
          "fontWeight": "700",
          "lineHeight": "1.2",
          "letterSpacing": "-0.025em"
        },
        "$type": "typography"
      },
      "lg": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "fontSize": "24px",
          "fontWeight": "600",
          "lineHeight": "1.3",
          "letterSpacing": "-0.02em"
        },
        "$type": "typography"
      },
      "md": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "fontSize": "20px",
          "fontWeight": "600",
          "lineHeight": "1.4",
          "letterSpacing": "-0.01em"
        },
        "$type": "typography"
      }
    },
    "body": {
      "lg": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "fontSize": "18px",
          "fontWeight": "400",
          "lineHeight": "1.6"
        },
        "$type": "typography"
      },
      "md": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "1.5"
        },
        "$type": "typography"
      },
      "sm": {
        "$value": {
          "fontFamily": "system-ui, -apple-system, sans-serif",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "1.5"
        },
        "$type": "typography"
      }
    }
  },
  "shadow": {
    "$description": "Box shadow scale.",
    "sm": {
      "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "rgba(0, 0, 0, 0.05)" },
      "$type": "shadow"
    },
    "md": {
      "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "6px", "spread": "-1px", "color": "rgba(0, 0, 0, 0.07)" },
      "$type": "shadow"
    },
    "lg": {
      "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px", "color": "rgba(0, 0, 0, 0.1)" },
      "$type": "shadow"
    }
  }
}
